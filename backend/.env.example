# =======================================================
# SmartCart AI — Backend Environment Configuration Example
# =======================================================

APP_NAME=SmartCart AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False

# Database Connection String
DATABASE_URL=postgresql+psycopg://postgres:your_db_password@your_pooler_host:6543/postgres

# JWT Security Secrets
SECRET_KEY=your_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins
BACKEND_CORS_ORIGINS=["https://smart-cart-snowy.vercel.app","http://localhost:5173"]

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Microservice URL
AI_SERVICE_URL=https://thor-777-smartcart.hf.space