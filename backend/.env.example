# =======================================================
# SmartCart AI — Backend Environment Configuration Example
# Local dev uses host psql on 5432 (see README)
# =======================================================

APP_NAME=SmartCart AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Database — host psql (local, 1005 products) — default for this repo
DATABASE_URL=postgresql+psycopg://smartcart_user:777@localhost:5432/smartcart
# Docker alternative: postgresql+psycopg://smartcart_user:777@localhost:5433/smartcart
# Supabase pooler (if you switch back): postgresql+psycopg://postgres:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Backup kept in backend/.env.supabase.bak (gitignored)

# JWT
SECRET_KEY=your_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — include Vercel deploy + localhost (see app/main.py DEV_ORIGINS union)
BACKEND_CORS_ORIGINS=["https://smart-cart-snowy.vercel.app","http://localhost:5173","http://localhost:3000"]

# Cloudinary (fallback to /static/uploads if not configured)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173

# AI
AI_SERVICE_URL=https://akash-yt3001--smartcart-ai-vision-fastapi-app.modal.run
AI_MODEL_PATH=https://thor-777-smartcart.hf.space

# Optional Supabase (paused, local only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
